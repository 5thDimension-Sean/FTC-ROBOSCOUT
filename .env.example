# FTC Events API — request credentials at
# https://ftc-events.firstinspires.org/services/API
# Copy this file to `.env` (git-ignored) and fill in what you need.

# --- DIRECT mode (native app / local dev) ---
# The FTC API has no CORS, so these only work on native or in Node, NOT in a
# browser. Used when EXPO_PUBLIC_FTC_PROXY_URL is not set.
EXPO_PUBLIC_FTC_API_USERNAME=your-username
EXPO_PUBLIC_FTC_API_KEY=your-api-key

# --- PROXY mode (web / public deploy) ---
# When set, the app calls this Cloudflare Worker (see proxy/) instead of the
# FTC API directly. The key lives in the Worker, so nothing ships in the bundle.
# EXPO_PUBLIC_FTC_PROXY_URL=https://ftc-robotscout-proxy.<you>.workers.dev

# Optional: season year. "2025" = the 2025–2026 game. Defaults to 2025.
EXPO_PUBLIC_FTC_SEASON=2025
